# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_PROVIDER: Pilih penyedia API WhatsApp otomatis ("twilio" | "fonnte" | "wablas" | "webhook")
WHATSAPP_PROVIDER="twilio"

# TWILIO WHATSAPP API CONFIGURATION (Jika menggunakan Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# THIRD-PARTY WHATSAPP GATEWAY CONFIGURATION (Contoh: Fonnte https://api.fonnte.com/send atau Wablas)
WHATSAPP_API_URL="https://api.fonnte.com/send"
WHATSAPP_API_TOKEN=""

# DEFAULT_SUPERVISOR_WHATSAPP: Nomor WhatsApp cadangan jika nomor telepon pegawai/atasan di MASTER_PEGAWAI kosong
DEFAULT_SUPERVISOR_WHATSAPP=""
